# Ignore directory - for local files that should not be tracked
.ignore/

# Project config - user-specific (template: config.example.json)
config.json

# Runtime lock files: one per run slot (and the mkdir-based fallback lock).
# A lock file outliving its run is normal — it is an inode to lock, not a
# record of anything. ./run.sh --status says what is actually running.
.run.lock
.run.lock.d/
.run.slot-*.lock
.run.slot-*.lock.d/

# Runtime files - user-specific state
data/prd.json
data/prd.archived.json
data/progress.txt
data/progress.archived.txt
data/run-state.json
data/run-state.slot-*.json
data/runs/
data/claims.json
data/.prd.lock
data/.progress.lock
.last-branch

# Trusted reviewers allowlist - user-specific
scripts/trusted-reviewers.txt

# Claude settings - user-specific (but track project skills)
.claude/settings.local.json

# Backup files
*.backup
*.bak

# Log files
*.log
logs/

# Temporary files
*.tmp
*.swp
*~

# OS files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/
*.iml

# direnv
.envrc

__pycache__
*.egg-info/
