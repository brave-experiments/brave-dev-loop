#!/bin/bash
# Pre-commit hook: two guards, in one file because one repository can need both.
#
#   - the bot account may not modify dependency files, so no external code is
#     pulled in via a dependency change
#   - nobody commits this loop's runtime state, whatever `git add -f` was aimed
#     at it
#
# They were two hooks until a deployment turned up where the target repo is the
# loop's own checkout: both wanted <repo>/hooks/pre-commit, setup installed one
# and every run reinstalled the other, and whichever lost went silently.
#
# Note: __BOT_USERNAME__ is replaced at installation time.

# The loop's own runtime state. Each one is in .gitignore, which stops the
# accident and not the intent -- `git add -f` reaches them, and a commit of one
# publishes a machine's live queue and then loses it to the next hard reset.
# Checked for every user: the file is nobody's to commit, not just the bot's.
NEVER_COMMIT=(
  "data/prd.json"
  "data/progress.txt"
  "data/run-state.json"
  "data/claims.json"
)

STAGED=$(git diff --cached --name-only)

BLOCKED_STATE=()
for file in "${NEVER_COMMIT[@]}"; do
  if printf '%s\n' "$STAGED" | grep -qxF "$file"; then
    BLOCKED_STATE+=("$file")
  fi
done

if [ ${#BLOCKED_STATE[@]} -gt 0 ]; then
  echo ""
  echo "❌ COMMIT BLOCKED: runtime state files staged"
  echo ""
  for file in "${BLOCKED_STATE[@]}"; do
    echo "  - $file"
  done
  echo ""
  echo "REASON: these hold this deployment's live queue and progress. They are"
  echo "        in .gitignore and belong to the machine, not to the history."
  echo ""
  echo "SOLUTION: git reset HEAD <file>"
  echo ""
  exit 1
fi

# Get the current git user
GIT_USER=$(git config user.name)

# Only enforce for bot account (configured by setup.sh)
if [ "$GIT_USER" = "__BOT_USERNAME__" ]; then
  echo "Checking for dependency file modifications ($GIT_USER account)..."

  # List of dependency files to check
  DEPENDENCY_FILES=(
    "package.json"
    "package-lock.json"
    "npm-shrinkwrap.json"
    "yarn.lock"
    "pnpm-lock.yaml"
    "pnpm-workspace.yaml"
    "DEPS"
    "Cargo.toml"
    "Cargo.lock"
    "go.mod"
    "go.sum"
    "Gemfile.lock"
    "poetry.lock"
    "Pipfile.lock"
    "composer.lock"
  )

  # Check if any dependency files are staged
  BLOCKED_FILES=()

  for file in "${DEPENDENCY_FILES[@]}"; do
    # Check recursively for these files in staged changes
    if git diff --cached --name-only | grep -E "(^|/)${file}$" > /dev/null; then
      BLOCKED_FILES+=("$file")
    fi
  done

  # If any dependency files found, block the commit
  if [ ${#BLOCKED_FILES[@]} -gt 0 ]; then
    echo ""
    echo "❌ COMMIT BLOCKED: Dependency file changes detected"
    echo ""
    echo "The following dependency files are being modified:"
    for file in "${BLOCKED_FILES[@]}"; do
      echo "  - $file"
    done
    echo ""
    echo "REASON: The $GIT_USER account is restricted from updating dependencies"
    echo "        that pull in external code. All fixes must use existing"
    echo "        dependencies already present in the codebase."
    echo ""
    echo "SOLUTION: Revert changes to dependency files and find an alternative"
    echo "          solution using existing code and libraries."
    echo ""
    exit 1
  fi

  echo "✓ No dependency file changes detected. Proceeding with commit."
fi

# Allow commit to proceed
exit 0
